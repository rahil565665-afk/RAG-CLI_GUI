# Replace with a NEW key after revoking any key pasted into chat or source control.
# Keep .env local. Never commit the real key.
GEMINI_API_KEY=YOUR_NEW_GEMINI_API_KEY
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional retrieval / API tuning
TOP_K=4
MIN_RELEVANCE=0.22
RATE_LIMIT_PER_MINUTE=30
# NORTHSIDE_KB_PATH=./data/northside_dental_knowledge_base.json